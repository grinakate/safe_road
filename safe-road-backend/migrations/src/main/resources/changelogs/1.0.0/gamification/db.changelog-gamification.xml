<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
		xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.0.xsd">
		  <changeSet id="gamification-create_levels" author="safe-road">
				<preConditions onFail="CONTINUE">
					<not>
						<tableExists tableName="levels"/>
					</not>
				</preConditions>
			<createTable tableName="levels">
			<column name="id" type="INTEGER" autoIncrement="true">
				<constraints primaryKey="true"
							 primaryKeyName="levels_pkey"
							 nullable="false"/>
			</column>
			<column name="title" type="TEXT">
				<constraints
						unique="true"
						nullable="false"/>
			</column>
			<column name="number" type="INTEGER">
				<constraints
						unique="true"
						nullable="false"/>
			</column>
			<column name="xp_threshold" type="INTEGER">
				<constraints
						nullable="false"/>
			</column>
		</createTable>
	</changeSet>
		  <changeSet id="gamification-create_avatars" author="safe-road">
				<preConditions onFail="CONTINUE">
					<not>
						<tableExists tableName="avatars"/>
					</not>
				</preConditions>
			<createTable tableName="avatars">
			<column name="id" type="INTEGER" autoIncrement="true">
				<constraints primaryKey="true"
							 primaryKeyName="avatars_pkey"
							 nullable="false"/>
			</column>
			<column name="url" type="TEXT">
				<constraints
						unique="true"
						nullable="false"/>
			</column>
			<column name="min_level" type="INTEGER">
				<constraints
						nullable="false"/>
			</column>
		</createTable>
	</changeSet>
		  <changeSet id="gamification-create_achievements" author="safe-road">
				<preConditions onFail="CONTINUE">
					<not>
						<tableExists tableName="achievements"/>
					</not>
				</preConditions>
			<createTable tableName="achievements">
			<column name="id" type="INTEGER" autoIncrement="true">
				<constraints primaryKey="true"
							 primaryKeyName="achievements_pkey"
							 nullable="false"/>
			</column>
			<column name="name" type="TEXT">
				<constraints
						unique="true"
						nullable="false"/>
			</column>
			<column name="description" type="TEXT">
				<constraints
						nullable="false"/>
			</column>
			<column name="icon_url" type="TEXT">
				<constraints
						nullable="false"/>
			</column>
			<column name="requirements" type="JSONB">
				<constraints
						nullable="false"/>
			</column>
			<column name="reward_xp" type="INTEGER">
				<constraints
						nullable="false"/>
			</column>
			<column name="is_active" type="BOOLEAN">
				<constraints
						nullable="false"/>
			</column>
		</createTable>
	</changeSet>
		  <changeSet id="gamification-create_user_achievements" author="safe-road">
				<preConditions onFail="CONTINUE">
					<not>
						<tableExists tableName="user_achievements"/>
					</not>
				</preConditions>
			<createTable tableName="user_achievements">
			<column name="user_id" type="BIGINT">
				<constraints
						nullable="false"/>
			</column>
			<column name="achievement_id" type="INTEGER">
				<constraints
						nullable="false"/>
			</column>
			<column name="earned_at" type="TIMESTAMP">
				<constraints
						nullable="false"/>
			</column>
		</createTable>
		<addPrimaryKey columnNames="user_id, achievement_id" constraintName="user_achievements_pkey"
					   tableName="user_achievements"/>
		<addForeignKeyConstraint baseColumnNames="user_id" baseTableName="user_achievements"
								 constraintName="fk_UserAchievements_user_id" referencedColumnNames="id"
								 referencedTableName="users"/>
		<addForeignKeyConstraint baseColumnNames="achievement_id" baseTableName="user_achievements"
								 constraintName="fk_UserAchievements_achievement_id" referencedColumnNames="id"
								 referencedTableName="achievements"/>
	</changeSet>
		  <changeSet id="gamification-create_user_metrics" author="safe-road">
				<preConditions onFail="CONTINUE">
					<not>
						<tableExists tableName="user_metrics"/>
					</not>
				</preConditions>
			<createTable tableName="user_metrics">
			<column name="user_id" type="BIGINT">
				<constraints
						nullable="false"/>
			</column>
			<column name="metric_code" type="TEXT">
				<constraints
						nullable="false"/>
			</column>
			<column name="value" type="BIGINT">
				<constraints
						nullable="false"/>
			</column>
			<column name="updated_at" type="TIMESTAMP">
				<constraints
						nullable="false"/>
			</column>
		</createTable>
		<addPrimaryKey columnNames="user_id, metric_code" constraintName="user_metrics_pkey" tableName="user_metrics"/>
		<addForeignKeyConstraint baseColumnNames="user_id" baseTableName="user_metrics"
								 constraintName="fk_user_metrics_user_id" referencedColumnNames="id"
								 referencedTableName="users"/>
	</changeSet>

		  <changeSet id="gamification-create_xp_history" author="safe-road">
				<preConditions onFail="CONTINUE">
					<not>
						<tableExists tableName="xp_history"/>
					</not>
				</preConditions>
			<createTable tableName="xp_history">
			<column name="user_id" type="BIGINT">
				<constraints nullable="false"/>
			</column>
			<column name="week_start" type="DATE">
				<constraints nullable="false"/>
			</column>
			<column name="xp" type="BIGINT">
				<constraints nullable="false"/>
			</column>
			<column name="updated_at" type="TIMESTAMP">
				<constraints nullable="false"/>
			</column>
		</createTable>
		<addPrimaryKey columnNames="user_id, week_start" constraintName="xp_history_pkey" tableName="xp_history"/>
		<addForeignKeyConstraint baseColumnNames="user_id" baseTableName="xp_history"
				constraintName="fk_xp_history_user_id" referencedColumnNames="id"
				referencedTableName="users"/>
	</changeSet>
		  <changeSet id="gamification-create_game_profiles" author="safe-road">
				<preConditions onFail="CONTINUE">
					<not>
						<tableExists tableName="game_profiles"/>
					</not>
				</preConditions>
			<createTable tableName="game_profiles">
			<column name="user_id" type="BIGINT" autoIncrement="true">
				<constraints primaryKey="true"
							 primaryKeyName="game_profiles_pkey"
							 nullable="false"/>
			</column>
			<column name="level_id" type="INTEGER">
				<constraints
						nullable="false"/>
			</column>
			<column name="avatar_id" type="INTEGER">
				<constraints
						nullable="false"/>
			</column>
			<column name="current_xp" type="INTEGER">
				<constraints
						nullable="false"/>
			</column>
			<column name="current_streak" type="INTEGER">
				<constraints
						nullable="false"/>
			</column>
			<column name="last_activity_date" type="TIMESTAMP">
			</column>
			<column name="total_active_days" type="INTEGER">
				<constraints
						nullable="false"/>
			</column>
			<column name="is_leaderboard_participant" type="BOOLEAN">
				<constraints
						nullable="false"/>
			</column>
		</createTable>
		<addForeignKeyConstraint baseColumnNames="user_id" baseTableName="game_profiles"
								 constraintName="fk_game_profiles_user_id" referencedColumnNames="id"
								 referencedTableName="users"/>
		<addForeignKeyConstraint baseColumnNames="level_id" baseTableName="game_profiles"
								 constraintName="fk_game_profiles_levels_id"
								 referencedColumnNames="id" referencedTableName="levels"/>
		<addForeignKeyConstraint baseColumnNames="avatar_id" baseTableName="game_profiles"
								 constraintName="fk_game_profiles_avatars_id"
								 referencedColumnNames="id" referencedTableName="avatars"/>
	</changeSet>
</databaseChangeLog>