# =====================================================================
# Flutter specific
# =====================================================================

# Build artifacts
# Игнорировать все скомпилированные выходные файлы Flutter (APK, IPA, веб-сборки и т.д.)
/build/

# Игнорировать кэш инструментов Dart и автоматически сгенерированные файлы.
.dart_tool/

# Generated Dart files by build_runner (json_serializable, freezed, etc.)
# Игнорировать файлы, сгенерированные такими пакетами, как json_serializable, freezed, auto_route и т.д.
*.g.dart
*.freezed.dart
*.gr.dart # Для auto_route
*.chopper.dart # Для chopper
*.drift.dart # Для drift (ранее moor)
*.pb.dart # Для Protobuf
*.pbenum.dart
*.pbjson.dart
*.pbserver.dart
*.pbgrpc.dart
*.isolate.dart # Если используешь Flutter isolates

# Flutter plugin generated files
# Игнорировать файлы, генерируемые плагинами Flutter.
.flutter-plugins
.flutter-plugins-dependencies

# =====================================================================
# Android specific
# =====================================================================

# Gradle build artifacts
# Игнорировать все выходные файлы сборки Gradle.
/android/build/
/android/app/build/
/android/.gradle/

# Local configuration files
# Игнорировать локальные свойства, которые содержат пути к SDK и другие специфичные для пользователя настройки.
/android/local.properties

# Keystore files (sensitive information)
# Игнорировать файлы хранилища ключей, которые содержат конфиденциальную информацию (пароли, ключи подписи).
/android/key.properties
/android/app/src/debug/debug.keystore

# =====================================================================
# iOS / macOS specific
# =====================================================================

# Xcode build artifacts
# Игнорировать все выходные файлы сборки Xcode.
/ios/build/
/macos/build/
/ios/DerivedData/

# Pods (dependency management for iOS)
# Игнорировать папку Pods, так как зависимости устанавливаются командой `pod install`.
/ios/Pods/
/ios/.symlinks/
/ios/Flutter/ephemeral/
/ios/.generated/

# Xcode workspace and project user data
# Игнорировать специфичные для пользователя настройки Xcode.
/ios/Runner.xcworkspace/xcuserdata/
/ios/Runner.xcodeproj/project.xcworkspace/xcuserdata/
/ios/Runner.xcodeproj/xcuserdata/

# Generated Xcode config files
/ios/Flutter/Generated.xcconfig
/macos/Flutter/GeneratedPluginRegistrant.swift # Иногда коммитят, но это сгенерированный файл

# =====================================================================
# Web specific
# =====================================================================

/web/build/

# =====================================================================
# IDE specific (VS Code, IntelliJ/Android Studio)
# =====================================================================

# IntelliJ / Android Studio
.idea/
*.iml
*.ipr
*.iws

# VS Code
# Игнорировать специфичные для пользователя настройки VS Code.
.vscode/*.local
# Если нужно игнорировать все, кроме определенных файлов:
# .vscode/
# !.vscode/settings.json
# !.vscode/launch.json
# !.vscode/extensions.json

# =====================================================================
# Operating System specific
# =====================================================================

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# =====================================================================
# General
# =====================================================================

# Logs and temporary files
*.log
*.temp
*.tmp
*~


.env
.env.*
secrets.dart