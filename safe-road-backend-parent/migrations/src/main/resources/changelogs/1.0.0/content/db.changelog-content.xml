<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
		xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.0.xsd">
	<changeSet id="content-002-sections" author="safe-road">
		<createTable tableName="Sections">
			<column autoIncrement="true" name="id" type="INTEGER">
				<constraints primaryKey="true" primaryKeyName="Sections_pkey"/>
			</column>
			<column name="title" type="TEXT">
				<constraints nullable="false"/>
			</column>
			<column name="order_index" type="INTEGER">
				<constraints nullable="false" unique="true"/>
			</column>
			<column name="is_active" type="BOOLEAN">
				<constraints nullable="false"/>
			</column>
		</createTable>
	</changeSet>
	<changeSet id="content-003-topics" author="safe-road">
		<createTable tableName="Topics">
			<column autoIncrement="true" name="id" type="INTEGER">
				<constraints primaryKey="true" primaryKeyName="Topics_pkey"/>
			</column>
			<column name="section_id" type="INTEGER">
				<constraints nullable="false"/>
			</column>
			<column name="title" type="TEXT">
				<constraints nullable="false"/>
			</column>
			<column name="content" type="JSONB">
				<constraints nullable="false"/>
			</column>
			<column name="order_index" type="INTEGER">
				<constraints nullable="false" unique="true"/>
			</column>
			<column name="is_active" type="BOOLEAN">
				<constraints nullable="false"/>
			</column>
		</createTable>
		<addForeignKeyConstraint baseColumnNames="section_id" baseTableName="Topics" constraintName="fk_topics_section"
								 referencedColumnNames="id" referencedTableName="Sections"/>
	</changeSet>
	<changeSet id="content-004-questions" author="safe-road">
		<createTable tableName="Questions">
			<column autoIncrement="true" name="id" type="BIGINT">
				<constraints primaryKey="true" primaryKeyName="Questions_pkey"/>
			</column>
			<column name="topic_id" type="INTEGER">
				<constraints nullable="false"/>
			</column>
			<column name="type" type="VARCHAR(255)">
				<constraints nullable="false"/>
			</column>
			<column name="difficulty_level" type="INTEGER">
				<constraints nullable="false"/>
			</column>
			<column name="content" type="JSONB">
				<constraints nullable="false"/>
			</column>
		</createTable>
		<addForeignKeyConstraint baseColumnNames="topic_id" baseTableName="Questions"
								 constraintName="fk_questions_topic" referencedColumnNames="id"
								 referencedTableName="Topics"/>
	</changeSet>
</databaseChangeLog>
